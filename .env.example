# foundation.py init creates .env with unique local secrets. Never commit .env.
# URLs below target host processes; container clients use service names/ports.
POSTGRES_DB=docusense
POSTGRES_USER=docusense
POSTGRES_PASSWORD=GENERATED
POSTGRES_PORT=55465
DATABASE_URL=GENERATED
REDIS_PASSWORD=GENERATED
REDIS_PORT=56379
REDIS_URL=GENERATED

# Private local MinIO with TLS and server-side encryption.
# NOTE: pick loopback ports outside the range 49000-65535. Docker Desktop on
# Windows reserves that range for its userland port proxy; bind() returns EPERM
# even with no listener. Verified-free range on this host: 38000-48000.
S3_PORT=39500
S3_CONSOLE_PORT=39501
S3_ENDPOINT=https://localhost:39500
S3_BUCKET=docusense-documents
S3_ACCESS_KEY=GENERATED
S3_SECRET_KEY=GENERATED
S3_REGION=us-east-1
S3_ENCRYPTION=AES256
# Required only when S3_ENCRYPTION=aws:kms.
# S3_KMS_KEY_ID=
AWS_CA_BUNDLE=infrastructure/local/certs/public.crt
# Development encryption key: preserve with the object-storage volume.
MINIO_KMS_SECRET_KEY=GENERATED
JWT_SECRET_KEY=GENERATED
LOG_LEVEL=INFO

# Exact browser/gateway policy and shared supported invoice currencies.
DOCUSENSE_CORS_ORIGINS=["http://localhost:3000"]
DOCUSENSE_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
DOCUSENSE_SUPPORTED_CURRENCIES=["USD","EUR","BDT"]

# Frontend server-only session and FastAPI gateway configuration. Never expose
# either value through a NEXT_PUBLIC_ variable.
BACKEND_API_ORIGIN=http://127.0.0.1:8000
FRONTEND_SESSION_SIGNING_SECRET=GENERATED_AT_LEAST_32_CHARACTERS
EXPORT_DOWNLOAD_ALLOWED_ORIGINS=https://localhost:39500

# RAG provider identities. Use immutable deployed revisions; keep API secrets only
# in the generated local .env or the production secret manager.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSIONS=384
HF_HOME=F:/DocuSenseModels/huggingface
DOCLING_ARTIFACTS_PATH=F:/DocuSenseModels/docling
EASYOCR_MODULE_PATH=F:/DocuSenseModels/docling/EasyOcr
LLM_PROVIDER=groq
LLM_API_KEY=
RAG_PIPELINE_VERSION=document-processing-rag-v1
RAG_PARSER_VERSION=docling-2.126.0
RAG_OCR_POLICY_VERSION=conditional-easyocr-en-v1
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_LLM_PROVIDER=groq
RAG_LLM_MODEL=openai/gpt-oss-20b
RAG_PROMPT_VERSION=commercial-invoice-v1
PROCESSING_AUTO_APPROVAL_ENABLED=false
